{
  "name": "storymode",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.mjs\" \"vite --host 127.0.0.1\"",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "test": "node --test test/*.test.mjs",
    "test:ui": "npm run build && playwright test",
    "check": "npm run build && npm test",
    "build:pages": "tsc -b && vite build --mode pages --outDir dist-pages",
    "preview:pages": "vite preview --outDir dist-pages --host 127.0.0.1",
    "test:pages": "npm run build:pages && playwright test -c playwright.pages.config.ts",
    "publish:pages": "node scripts/publish-pages.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.4",
    "fastify": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
  }
}
